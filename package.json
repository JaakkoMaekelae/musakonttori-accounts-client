{
  "name": "@musakonttori/accounts-client",
  "version": "0.1.0",
  "private": true,
  "description": "Client SDK for Musakonttori Accounts — headless JWT identity service",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache"
  },
  "dependencies": {
    "jose": "^6.2.7"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=16"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
